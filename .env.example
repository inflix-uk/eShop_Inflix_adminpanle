# Copy to `.env` and adjust. Restart `npm run dev` after changes.

# Backend REST base URL — trailing slash required (routes are built as `${VITE_BACKEND_URL}login`).
VITE_BACKEND_URL=http://localhost:4000/

# Socket.IO server URL (usually same host/port as the backend in development).
VITE_SOCKET_URL=http://localhost:4000

# Storefront origin (no trailing slash) — used by “Generate Sitemap” and similar links.
# Should match the public Next site (same host Google should index).
# VITE_PUBLIC_SITE_URL=https://www.your-store.example
# Optional aliases (first non-empty wins after VITE_PUBLIC_SITE_URL):
# VITE_STOREFRONT_URL=https://www.your-store.example
# VITE_FRONTEND_URL=https://www.your-store.example

# Optional client fallback — order APIs attach `lineImageUrl` on each cart line when the backend can resolve it.
# Set only if you still see broken thumbnails: same value as backend `BLOB_PUBLIC_BASE_URL` (Vercel Blob public origin, no trailing slash).
# VITE_BLOB_PUBLIC_BASE_URL=https://xxxx.public.blob.vercel-storage.com
